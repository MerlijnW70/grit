               ["genome", ["shr", "w", "GENOME_SHIFT"]],
               ["cost", ["upkeep", "genome"]],
               ["total", ["add", "energy", "gain"]],
               ["starved", ["le", "total", "cost"]],
               ["older", ["add", "age", 1]],
               ["span", ["add", ["mul", ["bits_of", "genome", "LIFESPAN_GENE", "GENE_MASK"], "AGE_STEP"], "AGE_LEAST"]],
               ["aged", ["gt", "older", "span"]],
               ["hit", ["struck_by", "roll", ["bits_of", "genome", "GUARD_GENE", "GENE_MASK"]]],
               ["ends", ["either", ["either", "starved", "aged"], "hit"]],
               ["died", ["both", "alive", "ends"]],
               ["lives", ["both", "alive", ["denied", "ends"]]],
               ["left", ["smaller", ["sub", "total", "cost"], "FULL"]],
               ["kept", ["or", ["or", ["and", "w", "KEEP_MASK"], ["shl", "left", "ENERGY_SHIFT"]], ["shl", "older", "AGE_SHIFT"]]],
               ["out", ["sel", "lives", "kept", ["sel", "alive", 0, "w"]]],
               ["threshold", ["add", ["mul", ["bits_of", "genome", "THRESHOLD_GENE", "GENE_MASK"], "THRESHOLD_STEP"], "THRESHOLD_LEAST"]],
               ["fertile", ["both", "lives", ["ge", "left", "threshold"]]]],
        ["vec", "out", "lives", "died", "left", "fertile"]]],
    "picked": [["free", "start", "axis"],
      ["at", ["fold", "state", ["vec", ["never"], ["never"]], "place", ["range", 3],
               ["let", [["here", ["at", ["vec", 0, 1, 2, 0, 1], ["add", "start", "place"]]],
                        ["open", ["at", "free", "here"]],
                        ["picks", ["both", "open", ["denied", ["at", "state", 0]]]]],
                 ["vec", ["either", ["at", "state", 0], "open"],
                         ["if", ["eq", "here", "axis"], "picks", ["at", "state", 1]]]]],
        1]],
    "chosen_by": [["free", "turn", "fertile"],
      ["map", "axis", ["range", 3],
        ["both", ["fold", "choice", ["never"], "start", ["range", 3],
                   ["either", "choice", ["both", ["eq", "turn", "start"], ["picked", "free", "start", "axis"]]]],
                 "fertile"]]],
    "turned_by": [["roll"], ["shr", ["mul", ["shr", "roll", 16], 3], 16]],
    "flips_by": [["base", "corner", "genome", "rate"],
      ["let", [["child", ["salted", ["xor", "base", ["or", ["shl", "genome", 3], "corner"]], "CHILD_SALT"]],
               ["draws", ["map", "pair", ["range", 8], ["salted", "child", ["mul", "BIT_SALT", ["add", "pair", 1]]]]],
               ["flags", ["map", "bit", ["range", "GENOME_BITS"],
                          ["let", [["draw", ["at", "draws", ["shr", "bit", 1]]]],
                            ["lt", ["if", ["eq", ["and", "bit", 1], 0], ["and", "draw", "CHANCE_MASK"], ["shr", "draw", 16]], "rate"]]]],
               ["mask", ["fold", "held", 0, "bit", ["range", "GENOME_BITS"],
                         ["or", "held", ["shl", ["word", ["at", "flags", "bit"]], "bit"]]]]],
        ["vec", "mask", "flags"]]],
    "resolved": [["choices", "lived", "target"],
      ["fold", "state", ["vec", ["never"], 0, ["vec"]], "place", ["range", 3],
        ["let", [["from", ["xor", "target", ["at", ["axes"], "place"]]],
                 ["claims", ["at", ["at", "choices", "from"], "place"]],
                 ["wins", ["both", "claims", ["denied", ["at", "state", 0]]]]],
          ["vec", ["either", ["at", "state", 0], "claims"],
                  ["sel", "wins", ["at", ["at", "lived", "from"], 0], ["at", "state", 1]],
                  ["concat", ["at", "state", 2], ["vec", "wins"]]]]]],
    "born_of": [["base", "resolution", "target"],
      ["let", [["parent", ["at", ["at", "resolution", "target"], 1]],
               ["half", ["shr", ["bits_of", "parent", "ENERGY_SHIFT", "FULL"], 1]],
               ["lineage", ["shr", "parent", "GENOME_SHIFT"]],
               ["flipped", ["flips_by", "base", "target", "lineage", ["param", "MUTATION"]]],
               ["heir", ["xor", "lineage", ["at", "flipped", 0]]]],
        ["vec", ["or", ["or", ["shl", "heir", "GENOME_SHIFT"], ["shl", "half", "ENERGY_SHIFT"]], "ALIVE"],
                ["at", "flipped", 1]]]],
    "paid_by": [["lived", "resolution", "placed", "corner"],
      ["let", [["gave", ["fold", "held", ["never"], "place", ["range", 3],
                          ["either", "held", ["at", ["at", ["at", "resolution", ["xor", "corner", ["at", ["axes"], "place"]]], 2], "place"]]]],
               ["energy", ["at", ["at", "lived", "corner"], 3]],
               ["kept", ["sub", "energy", ["shr", "energy", 1]]],
               ["birth", ["capped", "BIRTH_COST"]],
               ["spent", ["le", "kept", "birth"]],
               ["now", ["at", "placed", "corner"]],
               ["paid", ["or", ["and", "now", "ENERGY_CLEAR"], ["shl", ["sub", "kept", "birth"], "ENERGY_SHIFT"]]],
               ["after", ["sel", "spent", 0, "paid"]]],
        ["vec", ["sel", "gave", "after", "now"], ["both", "gave", "spent"]]]]
  },
  "step": ["let", [["base", ["mixed", ["xor", ["noise"], ["param", "SEED"]]]],
                   ["empties", ["sub", "CORNERS", ["count", ["map", "w", "cells", ["is_alive", "w"]]]]],
                   ["gain", ["mul", ["capped", "FEED"], "empties"]],
                   ["rolls", ["map", "k", ["range", 8], ["salted", "base", ["add", "ROLL_SALT", "k"]]]],
                   ["lived", ["map", "k", ["range", 8], ["lived_by", ["at", "cells", "k"], "gain", ["at", "rolls", "k"]]]],
                   ["free", ["map", "one", "lived", ["denied", ["at", "one", 1]]]],
                   ["choices", ["map", "k", ["range", 8],
                                ["chosen_by", ["map", "axis", ["axes"], ["at", "free", ["xor", "k", "axis"]]],
                                              ["turned_by", ["at", "rolls", "k"]],
                                              ["at", ["at", "lived", "k"], 4]]]],
                   ["resolution", ["map", "t", ["range", 8], ["resolved", "choices", "lived", "t"]]],
                   ["children", ["map", "t", ["range", 8], ["born_of", "base", "resolution", "t"]]],
                   ["placed", ["map", "t", ["range", 8],
                               ["sel", ["at", ["at", "resolution", "t"], 0], ["at", ["at", "children", "t"], 0], ["at", ["at", "lived", "t"], 0]]]],
                   ["settled", ["map", "c", ["range", 8], ["paid_by", "lived", "resolution", "placed", "c"]]],
                   ["out", ["map", "one", "settled", ["at", "one", 0]]],
                   ["flipped", ["fold", "all", ["vec"], "t", ["range", 8],
                                ["concat", "all", ["map", "flip", ["at", ["at", "children", "t"], 1],
                                                   ["both", "flip", ["at", ["at", "resolution", "t"], 0]]]]]]],
    ["vec", "out",
            ["vec", ["count", ["map", "k", ["range", 8], ["ne", ["at", "cells", "k"], ["at", "out", "k"]]]],
                    ["count", ["map", "w", "out", ["is_alive", "w"]]],
                    ["count", ["map", "one", "resolution", ["at", "one", 0]]],
                    ["add", ["count", ["map", "one", "lived", ["at", "one", 2]]], ["count", ["map", "one", "settled", ["at", "one", 1]]]],
                    ["count", "flipped"]]]]
}

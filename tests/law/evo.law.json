{
  "law": 1,
  "name": "evo",
  "params": 8,
  "channels": 1,
  "halo": 0,
  "tally": {"counts": 5, "weighted": true},
  "consts": {"ALIVE": 1, "ENERGY_SHIFT": 1, "FULL": 255, "AGE_SHIFT": 9, "OLDEST": 63, "GENOME_SHIFT": 16,
             "THRESHOLD_GENE": 0, "LIFESPAN_GENE": 2, "GUARD_GENE": 4, "GENE_MASK": 3,
             "THRESHOLD_LEAST": 64, "THRESHOLD_STEP": 32, "AGE_LEAST": 24, "AGE_STEP": 12,
             "FEED": 0, "UPKEEP": 1, "LIFE_COST": 2, "GUARD_COST": 3, "BIRTH_COST": 4, "HAZARD": 5, "MUTATION": 6, "SEED": 7,
             "COST_MOST": 255, "CHANCE_MASK": 65535, "CORNERS": 8, "GENOME_BITS": 16,
             "KEEP_MASK": 4294934529, "ENERGY_CLEAR": 4294966785,
             "ROLL_SALT": 1663821227, "CHILD_SALT": 2246822519, "BIT_SALT": 3266489917,
             "MIX_FIRST": 2146121005, "MIX_SECOND": 2221713035},
  "defs": {
    "never": [[], ["ne", 0, 0]],
    "axes": [[], ["vec", "X", "Y", "Z"]],
    "mixed": [["v"],
      ["let", [["a", ["xor", "v", ["shr", "v", 16]]],
               ["b", ["mul", "a", "MIX_FIRST"]],
               ["c", ["xor", "b", ["shr", "b", 15]]],
               ["d", ["mul", "c", "MIX_SECOND"]]],
        ["xor", "d", ["shr", "d", 16]]]],
    "salted": [["v", "salt"], ["mixed", ["xor", "v", "salt"]]],
    "smaller": [["v", "cap"], ["sel", ["gt", "v", "cap"], "cap", "v"]],
    "capped": [["which"], ["smaller", ["param", "which"], "COST_MOST"]],
    "bits_of": [["w", "from", "mask"], ["and", ["shr", "w", "from"], "mask"]],
    "is_alive": [["w"], ["eq", ["and", "w", "ALIVE"], "ALIVE"]],
    "upkeep": [["g"],

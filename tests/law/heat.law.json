{
  "law": 1,
  "name": "heat",
  "params": 3,
  "channels": 1,
  "halo": 0,
  "tally": {"counts": 3, "weighted": true},
  "consts": {"AIR": 0, "WALL": 1, "ICE": 2, "WATER": 3, "STEAM": 4, "FUEL": 5, "FIRE": 6, "ASH": 7,
             "KINDS": 8, "TOP": 65535, "MELT": 273, "BOIL": 373, "CONDENSE": 363, "WINDOW": 64,
             "LIT": 198, "DEGREE": 65536, "LIFE_STEP": 16, "STILL": 3},
  "defs": {
    "kind": [["w"], ["and", "w", 15]],
    "temp": [["w"], ["shr", "w", 16]],
    "with_kind": [["w", "k"], ["or", ["and", "w", 4294967280], "k"]],
    "with_temp": [["w", "t"], ["or", ["and", "w", 65535], ["shl", "t", 16]]],
    "smaller": [["v", "cap"], ["sel", ["gt", "v", "cap"], "cap", "v"]],
    "reacted": [["w", "nibble", "ignite", "chance", "flare"],
      ["let", [["kind", ["kind", "w"]], ["t", ["temp", "w"]],
               ["o1", ["sel", ["both", ["eq", "kind", "ICE"], ["ge", "t", "MELT"]], ["with_kind", "w", "WATER"], "w"]],
               ["o2", ["sel", ["both", ["eq", "kind", "WATER"], ["ge", "t", "BOIL"]], ["with_kind", "w", "STEAM"], "o1"]],
               ["o3", ["sel", ["both", ["eq", "kind", "STEAM"], ["lt", "t", "CONDENSE"]], ["with_kind", "w", "WATER"], "o2"]],
               ["hot", ["both", ["eq", "kind", "FUEL"], ["ge", "t", "ignite"]]],
               ["sure", ["either", ["ge", ["sub", "t", "ignite"], "WINDOW"], ["eq", "t", "TOP"]]],
               ["catches", ["either", "sure", ["lt", "nibble", "chance"]]],
               ["o4", ["sel", ["both", "hot", "catches"], ["or", ["and", "w", 4294967040], "LIT"], "o3"]],
               ["o5", ["sel", ["both", "hot", ["denied", "catches"]], ["add", "w", "DEGREE"], "o4"]],
               ["warmed", ["with_temp", "w", ["smaller", ["add", "t", ["smaller", "flare", "TOP"]], "TOP"]]],
               ["burnt", ["sel", ["eq", ["and", "w", 240], 0], ["with_kind", "warmed", "ASH"], ["sub", "warmed", "LIFE_STEP"]]]],
        ["sel", ["eq", "kind", "FIRE"], "burnt", "o5"]]],
    "conducting": [["w"], ["both", ["ne", ["kind", "w"], "WALL"], ["lt", ["kind", "w"], "KINDS"]]],
    "diffused": [["cells"],
      ["let", [["conducts", ["map", "w", "cells", ["conducting", "w"]]],
               ["sums", ["fold", "acc", ["vec", 0, 0, 4294967295], "k", ["range", 8],
                 ["let", [["warmth", ["temp", ["at", "cells", "k"]]], ["on", ["at", "conducts", "k"]],
                          ["warmest", ["at", "acc", 1]], ["coldest", ["at", "acc", 2]]],
                   ["vec", ["add", ["at", "acc", 0], ["mul", "warmth", ["word", "on"]]],
                           ["sel", ["both", ["gt", "warmth", "warmest"], "on"], "warmth", "warmest"],
                           ["sel", ["both", ["lt", "warmth", "coldest"], "on"], "warmth", "coldest"]]]]],
               ["total", ["at", "sums", 0]],
               ["uneven", ["gt", ["sub", ["at", "sums", 1], ["at", "sums", 2]], 1]],
               ["many", ["count", "conducts"]],
               ["share", ["div", "total", "many"]],
               ["rest", ["sub", "total", ["mul", "share", "many"]]],
               ["shared", ["fold", "acc", ["vec", "cells", 0], "k", ["range", 8],
                 ["let", [["on", ["at", "conducts", "k"]], ["rank", ["at", "acc", 1]],
                          ["t", ["add", "share", ["word", ["gt", "rest", "rank"]]]],
                          ["cell", ["at", "cells", "k"]]],
                   ["vec", ["put", ["at", "acc", 0], "k",
                             ["sel", ["both", "on", "uneven"], ["with_temp", "cell", "t"], "cell"]],
                           ["add", "rank", ["word", "on"]]]]]]],
        ["at", "shared", 0]]],
    "density": [["w"],
      ["fold", "d", "STILL", "pair", ["vec", ["vec", "STEAM", 0], ["vec", "AIR", 1], ["vec", "WATER", 2]],
        ["sel", ["eq", ["kind", "w"], ["at", "pair", 0]], ["at", "pair", 1], "d"]]],
    "moved": [["cells"],
      ["fold", "c", "cells", "top", ["range", 4],
        ["let", [["below", ["xor", "top", "Y"]], ["upper", ["at", "c", "top"]], ["lower", ["at", "c", "below"]],
                 ["over", ["density", "upper"]], ["under", ["density", "lower"]],
                 ["trade", ["both", ["both", ["lt", "over", "STILL"], ["lt", "under", "STILL"]], ["gt", "over", "under"]]]],
          ["put", ["put", "c", "top", ["sel", "trade", "lower", "upper"]], "below", ["sel", "trade", "upper", "lower"]]]]]
  },
  "step": ["let", [
      ["noise", ["noise"]],
      ["reacted_all", ["map", "k", ["range", 8],
        ["reacted", ["at", "cells", "k"], ["and", ["shr", "noise", ["mul", 4, "k"]], 15],
                    ["param", 0], ["param", 1], ["param", 2]]]],
      ["out", ["moved", ["diffused", "reacted_all"]]]],
    ["vec", "out",
      ["vec", ["count", ["map", "k", ["range", 8], ["ne", ["at", "cells", "k"], ["at", "out", "k"]]]],
              ["count", ["map", "w", "out", ["eq", ["kind", "w"], "FIRE"]]],
              ["count", ["map", "w", "out", ["eq", ["kind", "w"], "WATER"]]]]]]
}
